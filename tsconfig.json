{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"]
    },
    "types": ["nuxt",  "node"]
  },
  "include": [
    "nuxt.config.ts",
    "**/*.ts",
    "**/*.vue",
    "types"
  ]
}
